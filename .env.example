# Copy this to .env and fill in values
DATABASE_URL=postgresql+asyncpg://lp:lp@localhost:5432/lp_intelligence
REDIS_URL=redis://localhost:6379/0

# DealCloud — point at mock server locally, real URL in production
DEALCLOUD_BASE_URL=http://localhost:8001
DEALCLOUD_CLIENT_ID=mock-client-id
DEALCLOUD_CLIENT_SECRET=mock-secret
# For real DealCloud:
# DEALCLOUD_BASE_URL=https://comvest.dealcloud.com
# DEALCLOUD_CLIENT_ID=your-client-id
# DEALCLOUD_CLIENT_SECRET=your-client-secret

# AI — Claude for extraction, Voyage AI for embeddings
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# Phase 6 auth (leave blank for now)
SECRET_KEY=change-me-in-production
