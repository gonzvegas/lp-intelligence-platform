# Copy this to .env and fill in values
DATABASE_URL=postgresql+asyncpg://lp:lp@localhost:5432/lp_intelligence
REDIS_URL=redis://localhost:6379/0

# DealCloud — point at mock server locally, real URL in production
DEALCLOUD_BASE_URL=http://localhost:8001
DEALCLOUD_CLIENT_ID=mock-client-id
DEALCLOUD_CLIENT_SECRET=mock-secret
# For real DealCloud:
# DEALCLOUD_BASE_URL=https://comvest.dealcloud.com
# DEALCLOUD_CLIENT_ID=your-client-id
# DEALCLOUD_CLIENT_SECRET=your-client-secret

# AI — Claude for extraction, Voyage AI for embeddings
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

SECRET_KEY=change-me-in-production

# Document storage — local (dev/Docker volume) or azure (fund production)
STORAGE_BACKEND=local
DOCS_STORAGE_PATH=/data/docs
# Azure (when STORAGE_BACKEND=azure):
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_CONTAINER=lp-documents
# AZURE_STORAGE_CONNECTION_STRING=   # dev only; prod uses Managed Identity

# FastAPI: optional Bearer JWT (Entra v2 issuer + JWKS). Default skips validation for local dev.
SKIP_JWT_AUTH=true
JWT_TENANT_ID=
JWT_AUDIENCE=

# --- Frontend auth & SEO (prefix VITE_) ---
# Omit Entra vars → app shell open without MSAL. To test redirects, set client ID + authority:
# To bypass MSAL locally even when vars are filled (optional):
VITE_AUTH_DISABLED=true
#
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-guid>
VITE_ENTRA_API_SCOPE=api://<api-app-client-id>/access_as_user
# Canonical absolute URL for sitemap/canonical/meta (fallback: window.origin).
VITE_PUBLIC_SITE_URL=https://your-domain.example

# --- Frontend (build / dev defaults) ---
# VITE_USE_MOCKS=false + omit VITE_API_URL in dev → browser calls `/api`; Vite proxies to FastAPI on :8000 (avoids CORS).
VITE_USE_MOCKS=false
# Optional override (direct URL — may fail CORS if Vite runs on another port/host):
# VITE_API_URL=http://localhost:8000
