# Default: UI + built-in fixtures (no backend needed). Restart Vite after changing.
# IMPORTANT: `.env.development.local` overrides this file. If you still hit API timeouts, open that file and set VITE_USE_MOCKS=true (or delete VITE_USE_MOCKS=false).
VITE_USE_MOCKS=true

# Real API (PostgreSQL via Docker): set VITE_USE_MOCKS=false + restart Vite after `docker compose up`.
# Leave VITE_API_URL unset in dev → requests go to /api → proxied to :8000 (no CORS).
# VITE_USE_MOCKS=false

# Optional direct backend (can hit CORS if origin/port differs):
# VITE_API_URL=http://localhost:8000

# Only when Entra is configured and you still want unlocked shell locally:
# VITE_AUTH_DISABLED=true
